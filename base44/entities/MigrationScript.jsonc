{
  "name": "MigrationScript",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "up_sql": {
      "type": "string"
    },
    "down_sql": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validated",
        "approved",
        "executing",
        "completed",
        "rolled_back",
        "failed"
      ],
      "default": "draft"
    },
    "target_environment": {
      "type": "string"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "backup_checkpoint": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "confirmed": {
          "type": "boolean"
        }
      }
    },
    "execution_log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approved_by": {
      "type": "string"
    },
    "executed_by": {
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "project_id"
  ]
}